<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>10.0</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IsPackable>true</IsPackable>
        <PackageId>DomainFixture.SourceGenerator</PackageId>
        <Description>DomainFixture source generator with composed compile-time modules.</Description>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.1" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DomainFixture.Contracts\DomainFixture.Contracts.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\DomainFixture.Modules.FluentValidation\DomainFixture.Modules.FluentValidation.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\DomainFixture.TestGenerator\DomainFixture.TestGenerator.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <None Include="$(OutputPath)$(AssemblyName).dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
      <None Include="$(OutputPath)DomainFixture.Modules.FluentValidation.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
      <None Include="$(OutputPath)DomainFixture.TestGenerator.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
      <None Include="$(OutputPath)DomainFixture.Contracts.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
      <None Include="..\..\docs\compile-time-modules.md"
            Pack="true"
            PackagePath="README.md" />
    </ItemGroup>

</Project>
