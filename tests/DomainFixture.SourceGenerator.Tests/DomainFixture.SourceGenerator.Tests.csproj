<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>10.0</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="6.3.0" />
        <PackageReference Include="FluentValidation" Version="10.3.6" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.11.0" />
        <PackageReference Include="NUnit" Version="3.13.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.0.0" />
        <PackageReference Include="coverlet.collector" Version="3.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DomainFixture\DomainFixture.csproj" />
        <ProjectReference Include="..\..\src\DomainFixture.SourceGenerator\DomainFixture.SourceGenerator.csproj" />
        <ProjectReference Include="..\DomainFixture.Tests.Domain\DomainFixture.Tests.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\DomainFixture.Tests\Generation\RegistrationRequestFixture.cs"
              Link="Inputs\RegistrationRequestFixture.cs"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\DomainFixture.Tests\Generation\DomainFixtureProfile.cs"
              Link="Inputs\DomainFixtureProfile.cs"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\DomainFixture.Tests\Generation\UsernameFixture.cs"
              Link="Inputs\UsernameFixture.cs"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\DomainFixture.Tests\Generation\QualifiedNameFixture.cs"
              Link="Inputs\QualifiedNameFixture.cs"
              CopyToOutputDirectory="PreserveNewest" />
        <Compile Remove="Snapshots\**\*.verified.cs" />
        <None Include="Snapshots\**\*.verified.cs"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
